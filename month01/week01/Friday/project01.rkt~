; Функцийн нэр: rectangle-area
; Оролт: width, height (Тэгш өнцөгтийн өргөн, өндөр)
; Гаралт: Тэгш өнцөгтийн талбай
; Томьёо: width * height
(define (rectangle-area width height)
  (* width height))
(rectangle-area 15 8)

; Функцийн нэр: rectangle-perimeter
; Оролт: width, height (Тэгш өнцөгтийн өргөн, өндөр)
; Гаралт: Тэгш өнцөгтийн периметр
; Томьёо: (width + height) * 2
(define (rectangle-perimeter width height)
  (* (+ width height) 2))

(rectangle-perimeter 7 8)

; Функцийн нэр: minutes-to-seconds
; Оролт: minutes (Минутын утга)
; Гаралт: Секунд рүү шилжүүлсэн утга
; Томьёо: minutes * 60
(define (minutes-to-seconds minutes)
  (* minutes 60))
(minutes-to-seconds 5)

; Функцийн нэр: celsius-to-fahrenheit
; Оролт: celsius (Цельсийн градус)
; Гаралт: Фаренгейт рүү шилжүүлсэн утга
; Томьёо: (celsius * 9/5) + 32
(define (celsius-to-fahrenheit celsius)
  (+ (* celsius (/ 9 5)) 32))
(celsius-to-fahrenheit 15)

; Функцийн нэр: square-area
; Оролт: n (квадратын талын урт)
; Гаралт: Квадратын талбай
; Томьёо: n * n
(define (square-area n)
  (* n n))
(square-area 7)

